// Copy to ~/.config/pico/settings.json or {workspace}/.pico/settings.json
// Credentials live in ~/.config/pico/auth.json, env (PICO_API_KEY / OPENAI_API_KEY / HYPER_API_KEY / XAI_API_KEY),
// or `/login openai` / `/login hyper` / `/login xai`.
{
  // Active catalog id. Overridden by PICO_MODEL or OPENAI_MODEL. /model writes this key.
  "model": "gpt-5.6-sol",

  // Catalog used by /model and /effort. Workspace settings replace this array if present.
  // provider names a loaded LLM extension. base_url is optional; omit for the extension default.
  "models": [
    // {
    //   "name": "Sol",
    //   "id": "gpt-5.6-sol",
    //   "provider": "openai",
    //   "context_limit": 1000000,
    //   "vision": true,
    //   "effort": ["none", "low", "medium", "high"],
    //   "selected_effort": "medium"
    // },
    // Charm Hyper examples. Authenticate with HYPER_API_KEY or `/login hyper`.
    // {
    //   "name": "DeepSeek V4 Pro",
    //   "id": "deepseek-v4-pro",
    //   "provider": "hyper",
    //   "context_limit": 1000000,
    //   "effort": ["none", "high", "xhigh"],
    //   "selected_effort": "high"
    // },
    // xAI. Authenticate with XAI_API_KEY or `/login xai`.
    // {
    //   "name": "Grok 4.6",
    //   "id": "grok-4.6",
    //   "provider": "xai",
    //   "context_limit": 500000,
    //   "effort": ["low", "medium", "high", "xhigh"],
    //   "selected_effort": "high",
    //   "vision": true
    // }
  ],

  // Fallback when the selected model has no context_limit. Also set by PICO_CONTEXT_LIMIT.
  // "context_limit": 1000000,

  // Fraction of context_limit at which to compact (0.9 = 90%). null disables.
  // Default 0.9 if omitted. Overridden by PICO_COMPACT_AT.
  "compact_at": 0.9,

  // Continue the most recent JSONL session for this directory (same as pico --resume).
  // Overridden by PICO_RESUME_LAST.
  "resume_last": false,

  // User-global only: multiplier for all UI text. 1.0 is current sizes.
  // Overridden by PICO_FONT_SCALE. Range 0.5-3.0. `/settings` applies it immediately.
  "font_scale": 1.0,

  // User-global only: max chat/composer column width in characters (CSS ch,
  // body font). Default 90. 0 = no cap. Range 40-200. `/settings` applies it immediately.
  "chat_width": 90,

  // Host extension names disabled globally; `/extensions` or F2 updates this.
  // Ignored in workspace .pico/settings.json.
  // "disabled_host_extensions": ["footer"],

  // Workspace extension names to disable; `/extensions` or F2 updates this.
  // The builtin "extensions" manager and "settings" editor cannot be disabled.
  // "disabled_extensions": ["todos"]
}
